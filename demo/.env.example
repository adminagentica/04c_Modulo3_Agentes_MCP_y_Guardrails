# No pegar credenciales en prompts ni archivos de agentes.
COBRANZA_TOKEN=
COBRANZA_DB=data/cobranza.sqlite
COBRANZA_LLM=demo
CODEX_MODEL=gpt-6.1-sol
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
# capture guarda .eml locales. smtp solo permite Mailpit en loopback.
MAIL_MODE=capture
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# RAG existente de Clase_Agentica. Mantener false sin autorización de transferencia.
COBRANZA_RAG_URL=http://127.0.0.1:4173
COBRANZA_RAG_CORPUS=/Users/alexandergalvez/projects/Clase_Agentica/05_Corpus_Documental
COBRANZA_RAG_ALLOW_EXTERNAL=false

# App y Codex usan el workflow; la API key de OpenAI se guarda en n8n.
N8N_CHAT_URL=http://127.0.0.1:5678/webhook/agentica-cobranza-chat
